<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>cl.thenextsecurity.tns</groupId>
    <artifactId>TNS_TRACK_DEMO</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>TNS Track Backend</name>
    <description>Backend Spring Boot para TNS Track - Monitoreo camaras frias y rastreo GPS</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <spring-ai.version>1.0.0-M6</spring-ai.version>
    </properties>

    <!-- ================================================ -->
    <!-- Override de dependencias transitivas vulnerables  -->
    <!-- Fuerza versiones seguras sin cambiar la API       -->
    <!-- de las librerias que las incluyen (web-push)      -->
    <!-- ================================================ -->
    <dependencyManagement>
        <dependencies>

            <!-- Netty: vulnerabilidades CVE-2025-58056/57, CVE-2025-67735,  -->
            <!--        CVE-2025-25193, CVE-2025-24970 en 4.1.117.Final      -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-http</artifactId>
                <version>4.1.119.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-common</artifactId>
                <version>4.1.119.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec</artifactId>
                <version>4.1.119.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-handler</artifactId>
                <version>4.1.119.Final</version>
            </dependency>

            <!-- async-http-client: CVE-2024-53990 en 2.10.4 -->
            <dependency>
                <groupId>org.asynchttpclient</groupId>
                <artifactId>async-http-client</artifactId>
                <version>2.12.3</version>
            </dependency>

            <!-- jose4j: multiples CVEs en 0.7.0 -->
            <dependency>
                <groupId>org.bitbucket.b_c</groupId>
                <artifactId>jose4j</artifactId>
                <version>0.9.6</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ====================================== -->
        <!-- Spring Boot Core                       -->
        <!-- ====================================== -->

        <!-- REST API (reemplaza Express.js) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Seguridad y autenticacion (reemplaza express-jwt + cors middleware) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validacion de DTOs con anotaciones (@NotNull, @Email, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JDBC + HikariCP pool de conexiones (reemplaza pool manual MySQL2) -->
        <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-jdbc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <version>4.1.0-M2</version>
        </dependency>

        <!-- WebClient para llamadas HTTP salientes (Ubibot API, Shelly API) -->
        <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-webflux -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <version>4.1.0-M2</version>
        </dependency>
        <!-- Hot reload en desarrollo -->
        <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-devtools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <version>4.1.0-M2</version>
        </dependency>

        <!-- ====================================== -->
        <!-- Base de Datos                          -->
        <!-- ====================================== -->

        <!-- Driver MySQL (reemplaza mysql2 npm) -->
        <!-- Source: https://mvnrepository.com/artifact/com.mysql/mysql-connector-j -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.6.0</version>
        </dependency>

        <!-- ====================================== -->
        <!-- JWT - Autenticacion                    -->
        <!-- Reemplaza jsonwebtoken npm             -->
        <!-- ====================================== -->

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ====================================== -->
        <!-- Password Hashing                       -->
        <!-- BCrypt: incluido en spring-security    -->
        <!-- Argon2: usuarios legacy con hash       -->
        <!--         argon2 en BD existente         -->
        <!-- ====================================== -->

        <dependency>
            <groupId>de.mkammerer</groupId>
            <artifactId>argon2-jvm</artifactId>
            <version>2.11</version>
        </dependency>

        <!-- ====================================== -->
        <!-- Email                                  -->
        <!-- Reemplaza @sendgrid/mail npm           -->
        <!-- ====================================== -->

        <dependency>
            <groupId>com.sendgrid</groupId>
            <artifactId>sendgrid-java</artifactId>
            <version>4.10.2</version>
        </dependency>

        <!-- ====================================== -->
        <!-- Push Notifications PWA                 -->
        <!-- Reemplaza web-push npm                 -->
        <!-- IMPORTANTE: NO regenerar VAPID keys    -->
        <!--             al migrar (rompe           -->
        <!--             suscriptores existentes)   -->
        <!-- ====================================== -->

        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
            <version>5.1.2</version>
        </dependency>

        <!-- BouncyCastle: requerido por web-push para crypto ECDH (Java 17+/21+/25+) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.79</version>
        </dependency>

        <!-- ====================================== -->
        <!-- Generacion de PDF                      -->
        <!-- Reemplaza PDFKit + Puppeteer           -->
        <!-- OpenHTML2PDF: HTML a PDF sin Chrome    -->
        <!-- ====================================== -->

        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>

        <!-- Soporte SVG en PDF (graficos de reportes) -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-svg-support</artifactId>
            <version>1.0.10</version>
        </dependency>

        <!-- ====================================== -->
        <!-- Spring AI - Integracion OpenAI         -->
        <!-- Reemplaza openai npm                   -->
        <!-- ====================================== -->

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- ====================================== -->
        <!-- Scheduler - Jobs programados           -->
        <!-- Reemplaza node-cron + node-schedule    -->
        <!-- metricsAggregationJob + reportCleanup  -->
        <!-- ====================================== -->

        <!-- spring-boot-starter-quartz incluye quartz + spring-context-support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>

        <!-- ====================================== -->
        <!-- Utilidades                             -->
        <!-- ====================================== -->

        <!-- Reduccion de boilerplate (getters, setters, builders) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Serializacion correcta de LocalDate/LocalDateTime en JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- ====================================== -->
        <!-- Testing                                -->
        <!-- ====================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockMvc con seguridad (para probar endpoints protegidos) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Compiler plugin con soporte Lombok -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven plugin (excluye Lombok del JAR final) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Spring AI milestones (1.0.0-M6 aun no esta en Maven Central) -->
    <!-- JitPack para dependencias publicadas desde GitHub              -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <name>JitPack</name>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
